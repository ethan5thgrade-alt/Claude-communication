# Supabase — create a project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Broker — points the Next.js layer at the Python broker
# Dev: localhost. Prod: wss://broker.getmesh.dev
NEXT_PUBLIC_BROKER_WS=ws://localhost:8766
NEXT_PUBLIC_BROKER_HTTP=http://localhost:8765

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Phase 4+) Stripe — leave blank for Phase 1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=

# (Phase 3+) Resend — leave blank for Phase 1
RESEND_API_KEY=

# (Phase 6+) Admin panel
ADMIN_SECRET=

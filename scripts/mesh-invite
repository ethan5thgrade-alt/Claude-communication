#!/usr/bin/env bash
# mesh-invite — print a copy-pasteable connect snippet for a friend.
#
# Reads the live broker URL + token from ~/.agent-mesh/session.env and emits
# a one-line command the friend pastes into their terminal (or into their
# Claude Code session via the `!` prefix). The snippet pulls the latest
# mesh-connect.py from the public repo so the friend never has to clone.
#
# Usage:
#   ./scripts/mesh-invite                 # default: interactive (chat) mode
#   ./scripts/mesh-invite --listen        # receive-only snippet
#   ./scripts/mesh-invite --name "Bob"    # bake their display name in
#
# The tunnel URL rotates whenever cloudflared restarts. Re-run this any time
# you need a fresh invite.

set -euo pipefail

SESSION_FILE="${HOME}/.agent-mesh/session.env"
GH_RAW="https://raw.githubusercontent.com/ethan5thgrade-alt/Claude-communication/main/mesh-connect.py"

if [[ ! -f "${SESSION_FILE}" ]]; then
  echo "error: ${SESSION_FILE} not found." >&2
  echo "start the broker + cloudflared tunnel first, then write session.env." >&2
  exit 1
fi

# shellcheck disable=SC1090
set -a; source "${SESSION_FILE}"; set +a

if [[ -z "${BROKER_URL:-}" ]]; then
  echo "error: BROKER_URL not set in ${SESSION_FILE}." >&2
  exit 1
fi
if [[ -z "${MESH_TOKEN:-}" ]]; then
  echo "warning: MESH_TOKEN not set — broker may reject the connection." >&2
fi

MODE="interactive"
FRIEND_NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --listen) MODE="listen"; shift ;;
    --name)   FRIEND_NAME="${2:-}"; shift 2 ;;
    -h|--help)
      sed -n '2,15p' "$0"
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

FLAG=""
[[ "${MODE}" == "listen" ]] && FLAG=" --listen"

# Connector source. With a named tunnel (TUNNEL_URL is an https:// dashboard
# host that fronts the broker's HTTP port), the broker serves the connector at
# /connect.py over the same trusted origin as the token — no GitHub round-trip.
# The rotating quick tunnel only fronts the WS port, so fall back to GitHub raw.
CONNECT_SRC="${GH_RAW}"
if [[ "${TUNNEL_URL:-}" == https://* && "${TUNNEL_URL:-}" != *trycloudflare.com* ]]; then
  CONNECT_SRC="${TUNNEL_URL%/}/connect.py"
fi

NAME_PART=""
if [[ -n "${FRIEND_NAME}" ]]; then
  NAME_PART="INSTANCE_NAME=\"${FRIEND_NAME}\" "
fi

cat <<EOF
# === Agent Mesh invite ===
# Paste into a terminal (or into Claude Code with a leading \`!\`).
# Tunnel URL is ephemeral — if it stops working, ask for a fresh invite.

${NAME_PART}BROKER_URL='${BROKER_URL}' MESH_TOKEN='${MESH_TOKEN:-}' python3 <(curl -sL ${CONNECT_SRC})${FLAG}

# What this does:
#   - Pulls mesh-connect.py from ${CONNECT_SRC}
#   - Auto-installs the 'websockets' pip package if missing
#   - Registers your session with the mesh and starts chatting
#   - Type messages + Enter to broadcast; @<id> to DM; /quit to exit
EOF

#!/usr/bin/env bash
# claude-talk — make different Claude Code sessions talk to each other.
#
# Workflow:
#   In Claude Code session A (the first window):
#     ! claude-talk start cc1 "Claude A"
#   In Claude Code session B (a second window):
#     ! claude-talk start cc2 "Claude B"
#   From either:
#     ! claude-talk send cc2 "hi from cc1"
#     ! claude-talk inbox
#
# Each session registers a distinct instance id. Messages flow through the
# local broker (auto-started on first use).
#
# Rooms isolate traffic between projects:
#   ! claude-talk start cc1 "Claude A" --room sitelab
#   ! claude-talk start cc2 "Angus" --room sitelab
#
# Internet sharing via ngrok:
#   ! claude-talk share              — starts ngrok tunnels, prints join command
#   ! claude-talk join <url> cc2 "Angus" --room sitelab

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="${AGENT_MESH_REPO:-$(cd "$HERE/.." && pwd)}"
BROKER_PID_FILE="$HOME/.agent-mesh-broker.pid"
INBOX_DIR="$HOME/.agent-mesh-inbox"
# Recover the mesh token persisted by join/team-join (or the tunnel session)
# when MESH_TOKEN isn't already in the environment.
MESH_TOKEN="${MESH_TOKEN:-$(cat "$INBOX_DIR/.mesh_token" 2>/dev/null || true)}"
if [ -z "${MESH_TOKEN:-}" ]; then
    MESH_TOKEN="$(grep '^MESH_TOKEN=' "$HOME/.agent-mesh/session.env" 2>/dev/null | head -1 | cut -d= -f2 || true)"
fi
PYTHON_BIN="${PYTHON_BIN:-python3}"
BROKER_HOST="${MESH_HOST:-localhost}"
BROKER_PORT="${MESH_UI_PORT:-8765}"
BASE="http://${BROKER_HOST}:${BROKER_PORT}"

cmd="${1:-help}"; shift || true

_broker_running() {
    curl -sf "${BASE}/api/health" >/dev/null 2>&1
}

_start_broker() {
    if _broker_running; then return 0; fi
    echo "[claude-talk] starting broker..." >&2
    mkdir -p "$INBOX_DIR"
    # Launch detached, write pid file. stderr goes to a log so we can debug.
    nohup "$PYTHON_BIN" -u "$REPO/broker.py" \
        >"$HOME/.agent-mesh-broker.log" 2>&1 &
    echo $! > "$BROKER_PID_FILE"
    # Wait up to 10s for it to come up
    for _ in $(seq 1 50); do
        if _broker_running; then return 0; fi
        sleep 0.2
    done
    echo "[claude-talk] broker did not come online — see $HOME/.agent-mesh-broker.log" >&2
    return 1
}

# Read the stored broker URL (set by 'join' when connecting to a remote broker)
_get_base() {
    local stored_url
    stored_url="$(cat "$INBOX_DIR/.broker_url" 2>/dev/null || echo "")"
    if [ -n "$stored_url" ]; then
        echo "$stored_url"
    else
        echo "$BASE"
    fi
}

# Read the current room for this session
_get_room() {
    cat "$INBOX_DIR/.room" 2>/dev/null || echo "default"
}

case "$cmd" in
    start)
        # claude-talk start <instance_id> [name] [--room <name>]
        instance_id="${1:?usage: claude-talk start <instance_id> [name] [--room <name>]}"
        shift
        name="$instance_id"
        room="default"

        # Parse optional positional name and --room flag
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --room)
                    room="${2:?--room requires a value}"
                    shift 2
                    ;;
                --room=*)
                    room="${1#--room=}"
                    shift
                    ;;
                *)
                    name="$1"
                    shift
                    ;;
            esac
        done

        _start_broker
        mkdir -p "$INBOX_DIR"
        # Persist this session's id and room so subsequent calls know who we are
        echo "$instance_id" > "$INBOX_DIR/.me"
        echo "$room" > "$INBOX_DIR/.room"
        # Remove any stored remote broker URL (we're using local broker)
        rm -f "$INBOX_DIR/.broker_url"

        # Kill any prior listener for this instance to avoid double-registration.
        if [ -f "$INBOX_DIR/${instance_id}.pid" ]; then
            kill "$(cat "$INBOX_DIR/${instance_id}.pid")" 2>/dev/null || true
            sleep 0.2
        fi
        # The listener appends every incoming message to the inbox file.
        nohup env \
            INSTANCE_ID="$instance_id" \
            INSTANCE_NAME="$name" \
            INSTANCE_PROJECT="${INSTANCE_PROJECT:-claude-code}" \
            INSTANCE_ROOM="$room" \
            BROKER_URL="ws://localhost:${MESH_INST_PORT:-8766}" \
            ${MESH_TOKEN:+MESH_TOKEN="$MESH_TOKEN"} \
            "$PYTHON_BIN" -u "$REPO/connect.py" \
            >"$INBOX_DIR/${instance_id}.log" 2>&1 &
        echo $! > "$INBOX_DIR/${instance_id}.pid"
        sleep 0.6
        echo "[claude-talk] registered as ${instance_id} (\"${name}\") in room \"${room}\". Inbox: $INBOX_DIR/${instance_id}.log"
        ;;

    send)
        # claude-talk send <to> <msg...> — sends FROM whatever this session
        # registered as via `start`. Falls back to "you" if nothing registered.
        to="${1:?usage: claude-talk send <to> <message>}"; shift
        msg="$*"
        sender="$(cat "$INBOX_DIR/.me" 2>/dev/null || echo "you")"
        room="$(_get_room)"
        base="$(_get_base)"

        # Start broker only if using local broker (no remote URL stored)
        if [ ! -f "$INBOX_DIR/.broker_url" ]; then
            _start_broker
        fi

        body="$(printf '{"to":"%s","text":"%s","from":"%s","room":"%s"}' \
                "$to" \
                "$(printf '%s' "$msg" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read())[1:-1])')" \
                "$sender" \
                "$room")"
        curl -sf -X POST "${base}/api/send" \
            -H 'Content-Type: application/json' \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
            -d "$body" | python3 -m json.tool
        ;;

    inbox)
        # claude-talk inbox [count]   — last N messages addressed to this session
        n="${1:-20}"
        me="$(cat "$INBOX_DIR/.me" 2>/dev/null || echo "")"
        room="$(_get_room)"
        base="$(_get_base)"
        if [ -z "$me" ]; then
            echo "no instance registered — run 'claude-talk start <id>' first" >&2
            exit 1
        fi
        curl -sf "${base}/api/status?room=${room}" \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
        | python3 -c "
import json, sys
me = '$me'
limit = $n
data = json.load(sys.stdin)
msgs = [m for m in data.get('messages', []) if m.get('to') in (me, 'all')][-limit:]
for m in msgs:
    print(f\"[{m.get('ts','')}] {m.get('from','?')} -> {m.get('to','?')}: {m.get('text','')}\")
"
        ;;

    listen)
        # claude-talk listen   — tail this session's incoming log
        me="$(cat "$INBOX_DIR/.me" 2>/dev/null || echo "")"
        if [ -z "$me" ]; then
            echo "no instance registered — run 'claude-talk start <id>' first" >&2
            exit 1
        fi
        tail -F "$INBOX_DIR/${me}.log"
        ;;

    who)
        me="$(cat "$INBOX_DIR/.me" 2>/dev/null || echo "(not registered)")"
        room="$(_get_room)"
        base="$(_get_base)"
        echo "I am: $me (room: $room)"
        if curl -sf "${base}/api/health" >/dev/null 2>&1; then
            echo "Broker: $base (running)"
            curl -sf "${base}/api/instances?room=${room}" \
                ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
                | python3 -m json.tool
        else
            echo "Broker: $base (not running)"
        fi
        ;;

    rooms)
        # claude-talk rooms — list active rooms on the broker
        base="$(_get_base)"
        if ! curl -sf "${base}/api/health" >/dev/null 2>&1; then
            echo "[claude-talk] broker not running at $base" >&2
            exit 1
        fi
        curl -sf "${base}/api/rooms" \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
        | python3 -c "
import json, sys
data = json.load(sys.stdin)
rooms = data.get('rooms', [])
if not rooms:
    print('(no rooms found)')
else:
    print(f\"{'ROOM':<20} {'ONLINE':>8}\")
    print('-' * 30)
    for r in rooms:
        print(f\"{r.get('name','?'):<20} {r.get('online_instances',0):>8}\")
"
        ;;

    room)
        # claude-talk room <name> — switch this session's current room
        new_room="${1:?usage: claude-talk room <name>}"
        mkdir -p "$INBOX_DIR"
        echo "$new_room" > "$INBOX_DIR/.room"
        echo "[claude-talk] switched to room \"$new_room\""
        echo "Note: existing connect.py listener is still registered in its original room."
        echo "      Run 'claude-talk start <id> [name] --room $new_room' to re-register."
        ;;

    share)
        # claude-talk share [--room <name>] [--team]
        # Starts ngrok tunnels for ports 8765 (HTTP/REST) and 8766 (WS instances)
        # and prints a join command Angus can paste.
        # --team: auto-create a team and print a single one-liner command.
        share_room="default"
        share_team=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --room)
                    share_room="${2:?--room requires a value}"
                    shift 2
                    ;;
                --room=*)
                    share_room="${1#--room=}"
                    shift
                    ;;
                --team)
                    share_team=1
                    shift
                    ;;
                *)
                    echo "[claude-talk] unknown argument: $1" >&2
                    exit 1
                    ;;
            esac
        done

        # Check broker is running
        _start_broker

        # Check ngrok is installed
        if ! command -v ngrok >/dev/null 2>&1; then
            echo "[claude-talk] ngrok is not installed." >&2
            echo "" >&2
            echo "Install it:" >&2
            echo "  brew install ngrok/ngrok/ngrok" >&2
            echo "  — or —" >&2
            echo "  curl -s https://ngrok-agent.s3.amazonaws.com/ngrok.asc | sudo tee /etc/apt/trusted.gpg.d/ngrok.asc" >&2
            echo "  Download from: https://ngrok.com/download" >&2
            exit 1
        fi

        echo "[claude-talk] starting ngrok tunnels (HTTP port ${MESH_UI_PORT:-8765}, TCP port ${MESH_INST_PORT:-8766})..." >&2

        # Kill any existing ngrok processes so we get fresh tunnels
        pkill -f "ngrok" 2>/dev/null || true
        sleep 0.5

        # Start ngrok HTTP tunnel for UI/REST (port 8765)
        nohup ngrok http "${MESH_UI_PORT:-8765}" \
            >"$HOME/.agent-mesh-ngrok-http.log" 2>&1 &
        echo $! > "$HOME/.agent-mesh-ngrok-http.pid"

        # Start ngrok TCP tunnel for WebSocket instances (port 8766)
        nohup ngrok tcp "${MESH_INST_PORT:-8766}" \
            >"$HOME/.agent-mesh-ngrok-tcp.log" 2>&1 &
        echo $! > "$HOME/.agent-mesh-ngrok-tcp.pid"

        # Wait for ngrok API to come up
        echo "[claude-talk] waiting for ngrok tunnels..." >&2
        for i in $(seq 1 30); do
            if curl -sf "http://localhost:4040/api/tunnels" >/dev/null 2>&1; then
                break
            fi
            sleep 0.5
            if [ "$i" -eq 30 ]; then
                echo "[claude-talk] ngrok API did not come up. Check $HOME/.agent-mesh-ngrok-http.log" >&2
                exit 1
            fi
        done

        # Parse public URLs from ngrok API
        TUNNELS_JSON="$(curl -sf "http://localhost:4040/api/tunnels")"
        HTTP_URL="$(echo "$TUNNELS_JSON" | python3 -c "
import json, sys
data = json.load(sys.stdin)
tunnels = data.get('tunnels', [])
for t in tunnels:
    proto = t.get('proto', '')
    pub_url = t.get('public_url', '')
    # HTTP tunnel will be 'https' proto pointing to localhost:8765
    if proto in ('https', 'http') and '8765' in t.get('config', {}).get('addr', ''):
        print(pub_url)
        break
    # fallback: any https tunnel
    if proto == 'https':
        print(pub_url)
        break
" 2>/dev/null || echo "")"
        TCP_URL="$(echo "$TUNNELS_JSON" | python3 -c "
import json, sys
data = json.load(sys.stdin)
tunnels = data.get('tunnels', [])
for t in tunnels:
    proto = t.get('proto', '')
    pub_url = t.get('public_url', '')
    if proto == 'tcp':
        # Convert tcp://host:port -> ws://host:port
        ws_url = pub_url.replace('tcp://', 'ws://')
        print(ws_url)
        break
" 2>/dev/null || echo "")"

        if [ -z "$HTTP_URL" ] || [ -z "$TCP_URL" ]; then
            echo "[claude-talk] could not read tunnel URLs from ngrok API." >&2
            echo "Raw tunnel data:" >&2
            echo "$TUNNELS_JSON" >&2
            echo "" >&2
            echo "Try running manually:" >&2
            echo "  ngrok http ${MESH_UI_PORT:-8765}" >&2
            echo "  ngrok tcp ${MESH_INST_PORT:-8766}" >&2
            exit 1
        fi

        echo ""
        echo "============================================================"
        echo "  AGENT MESH — SHARING ACTIVE"
        echo "============================================================"
        echo ""
        echo "  UI/REST: $HTTP_URL"
        echo "  WS:      $TCP_URL"
        echo ""

        if [ "$share_team" -eq 1 ]; then
            # Auto-create a team and print the one-liner
            team_resp="$(curl -sf -X POST "${BASE}/api/teams" \
                -H 'Content-Type: application/json' \
                ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
                -d "$(python3 -c "import json; print(json.dumps({'name':'collab','room':'$share_room'}))")" || echo "")"
            if [ -n "$team_resp" ]; then
                invite_code="$(echo "$team_resp" | python3 -c "import json,sys; print(json.load(sys.stdin)['invite_code'])")"
                mkdir -p "$INBOX_DIR"
                echo "$team_resp" | python3 -c "
import json, sys
d = json.load(sys.stdin)
with open('$INBOX_DIR/.team', 'w') as f:
    json.dump({'team_id': d['team_id'], 'invite_code': d['invite_code'], 'room': d['room'], 'name': d['name']}, f)
"
                echo "  Team invite code: $invite_code"
                echo "  Room: $share_room"
                echo ""
                echo "  ===== PASTE THIS ONE COMMAND INTO ANGUS'S CLAUDE CODE ====="
                echo ""
                if [ -n "${MESH_TOKEN:-}" ]; then
                    echo "  ! MESH_TOKEN=${MESH_TOKEN} BROKER_URL=${HTTP_URL} claude-talk team join ${invite_code} cc2 \"Angus\""
                else
                    echo "  ! BROKER_URL=${HTTP_URL} claude-talk team join ${invite_code} cc2 \"Angus\""
                fi
                echo ""
                echo "  ============================================================"
            else
                echo "  [warning] Could not auto-create team. Use manual join command below." >&2
                if [ -n "${MESH_TOKEN:-}" ]; then
                    echo "  ! MESH_TOKEN=${MESH_TOKEN} claude-talk join $HTTP_URL cc2 \"Angus\" --room $share_room"
                else
                    echo "  ! claude-talk join $HTTP_URL cc2 \"Angus\" --room $share_room"
                fi
            fi
        else
            echo "  Send Angus this command to join:"
            echo ""
            if [ -n "${MESH_TOKEN:-}" ]; then
                echo "  ! MESH_TOKEN=${MESH_TOKEN} claude-talk join $HTTP_URL cc2 \"Angus\" --room $share_room"
            else
                echo "  ! claude-talk join $HTTP_URL cc2 \"Angus\" --room $share_room"
            fi
            echo ""
            echo "  Or use the team system (recommended for multi-account):"
            echo "  Run: claude-talk share --team"
        fi

        echo ""
        echo "  WS override: BROKER_WS_URL=$TCP_URL"
        echo "============================================================"
        echo ""
        echo "Ngrok logs: $HOME/.agent-mesh-ngrok-http.log"
        echo "            $HOME/.agent-mesh-ngrok-tcp.log"
        ;;

    join)
        # claude-talk join <broker_http_url> <instance_id> [name] [--room <name>] [--broker <url>] [--token <tok>]
        # Connects to a remote broker instead of starting a local one.
        # When called from 'team join', broker_http_url may be "SKIP" and --broker is set.
        broker_http_url="${1:?usage: claude-talk join <broker_http_url> <instance_id> [name] [--room <name>]}"
        shift
        instance_id="${1:?usage: claude-talk join <broker_http_url> <instance_id> [name] [--room <name>]}"
        shift
        name="$instance_id"
        join_room="default"
        join_token="${MESH_TOKEN:-}"

        # Parse optional positional name and flags
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --room)
                    join_room="${2:?--room requires a value}"
                    shift 2
                    ;;
                --room=*)
                    join_room="${1#--room=}"
                    shift
                    ;;
                --broker)
                    broker_http_url="${2:?--broker requires a value}"
                    shift 2
                    ;;
                --broker=*)
                    broker_http_url="${1#--broker=}"
                    shift
                    ;;
                --token)
                    join_token="${2:?--token requires a value}"
                    shift 2
                    ;;
                --token=*)
                    join_token="${1#--token=}"
                    shift
                    ;;
                *)
                    name="$1"
                    shift
                    ;;
            esac
        done

        # Normalize broker_http_url: strip trailing slash
        broker_http_url="${broker_http_url%/}"

        # If a token was supplied via flag, export it so subsequent curl calls pick it up
        if [ -n "$join_token" ]; then
            export MESH_TOKEN="$join_token"
        fi

        # Derive WebSocket URL from HTTP URL (http->ws, https->wss)
        # If BROKER_WS_URL is already set in environment, use that instead.
        if [ -n "${BROKER_WS_URL:-}" ]; then
            broker_ws_url="$BROKER_WS_URL"
        else
            broker_ws_url="$(echo "$broker_http_url" | sed 's|^http://|ws://|; s|^https://|wss://|')"
        fi

        # Check the remote broker is reachable
        echo "[claude-talk] checking remote broker at $broker_http_url..." >&2
        if ! curl -sf "${broker_http_url}/api/health" \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} >/dev/null 2>&1; then
            echo "[claude-talk] ERROR: cannot reach broker at ${broker_http_url}/api/health" >&2
            echo "  Make sure the broker is running and the URL is correct." >&2
            echo "  If using ngrok, ensure the tunnel is active." >&2
            exit 1
        fi
        echo "[claude-talk] remote broker is up." >&2

        mkdir -p "$INBOX_DIR"
        # Persist session info
        echo "$instance_id" > "$INBOX_DIR/.me"
        echo "$join_room" > "$INBOX_DIR/.room"
        # Store the remote broker HTTP URL so send/inbox/who use it
        echo "$broker_http_url" > "$INBOX_DIR/.broker_url"
        # Store token if provided
        if [ -n "$join_token" ]; then
            echo "$join_token" > "$INBOX_DIR/.mesh_token"
        fi

        # Kill any prior listener for this instance
        if [ -f "$INBOX_DIR/${instance_id}.pid" ]; then
            kill "$(cat "$INBOX_DIR/${instance_id}.pid")" 2>/dev/null || true
            sleep 0.2
        fi

        # Spawn connect.py pointed at the remote broker's WebSocket URL
        nohup env \
            INSTANCE_ID="$instance_id" \
            INSTANCE_NAME="$name" \
            INSTANCE_PROJECT="${INSTANCE_PROJECT:-claude-code}" \
            INSTANCE_ROOM="$join_room" \
            BROKER_URL="$broker_ws_url" \
            ${MESH_TOKEN:+MESH_TOKEN="$MESH_TOKEN"} \
            "$PYTHON_BIN" -u "$REPO/connect.py" \
            >"$INBOX_DIR/${instance_id}.log" 2>&1 &
        echo $! > "$INBOX_DIR/${instance_id}.pid"
        sleep 0.8

        echo "[claude-talk] joined remote broker as ${instance_id} (\"${name}\") in room \"${join_room}\""
        echo "  Broker:  $broker_http_url"
        echo "  WS:      $broker_ws_url"
        echo "  Log:     $INBOX_DIR/${instance_id}.log"
        echo ""
        echo "Use 'claude-talk inbox' and 'claude-talk send' as normal."
        ;;

    team)
        # claude-talk team <subcommand> ...
        subcmd="${1:-info}"; shift || true

        case "$subcmd" in
            create)
                # claude-talk team create <name> [--room <room>]
                team_name="${1:?usage: claude-talk team create <name> [--room <room>]}"
                shift
                team_room=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --room) team_room="${2:?--room requires a value}"; shift 2 ;;
                        --room=*) team_room="${1#--room=}"; shift ;;
                        *) shift ;;
                    esac
                done

                # Start broker if not running
                _start_broker

                body="$(python3 -c "import json,sys; d={'name':sys.argv[1]}; d.update({'room':sys.argv[2]} if sys.argv[2] else {}); print(json.dumps(d))" "$team_name" "$team_room")"
                response="$(curl -sf -X POST "${BASE}/api/teams" \
                    -H 'Content-Type: application/json' \
                    ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
                    -d "$body")"
                if [ -z "$response" ]; then
                    echo "[claude-talk] ERROR: failed to create team" >&2
                    exit 1
                fi

                team_id="$(echo "$response" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['team_id'])")"
                invite_code="$(echo "$response" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['invite_code'])")"
                room_name="$(echo "$response" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['room'])")"

                mkdir -p "$INBOX_DIR"
                printf '{"team_id":"%s","invite_code":"%s","room":"%s","name":"%s"}' \
                    "$team_id" "$invite_code" "$room_name" "$team_name" \
                    > "$INBOX_DIR/.team"

                echo ""
                echo "============================================================"
                echo "  TEAM CREATED: $team_name"
                echo "============================================================"
                echo ""
                echo "  Team ID:     $team_id"
                echo "  Invite Code: $invite_code"
                echo "  Room:        $room_name"
                echo ""
                echo "  Share this with your team:"
                echo "  claude-talk team join $invite_code cc2 \"Angus\""
                echo ""
                if [ -n "${MESH_TOKEN:-}" ]; then
                    echo "  With token:"
                    echo "  MESH_TOKEN=${MESH_TOKEN} claude-talk team join $invite_code cc2 \"Angus\""
                    echo ""
                fi
                echo "============================================================"
                ;;

            join)
                # claude-talk team join <invite_code> <instance_id> [name] [--broker <url>] [--token <tok>]
                invite_code="${1:?usage: claude-talk team join <invite_code> <instance_id> [name]}"
                shift
                instance_id="${1:?usage: claude-talk team join <invite_code> <instance_id> [name]}"
                shift
                member_name="$instance_id"
                tj_broker="${BROKER_URL:-}"
                tj_token="${MESH_TOKEN:-}"

                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --broker) tj_broker="${2:?--broker requires a value}"; shift 2 ;;
                        --broker=*) tj_broker="${1#--broker=}"; shift ;;
                        --token) tj_token="${2:?--token requires a value}"; shift 2 ;;
                        --token=*) tj_token="${1#--token=}"; shift ;;
                        *) member_name="$1"; shift ;;
                    esac
                done

                # Determine which broker to talk to
                if [ -z "$tj_broker" ]; then
                    # Try stored broker URL, then default local
                    tj_broker="$(cat "$INBOX_DIR/.broker_url" 2>/dev/null || echo "$BASE")"
                fi
                tj_broker="${tj_broker%/}"

                # Export token if provided
                if [ -n "$tj_token" ]; then
                    export MESH_TOKEN="$tj_token"
                fi

                echo "[claude-talk] resolving invite code $invite_code at $tj_broker..." >&2
                invite_info="$(curl -sf "${tj_broker}/api/invite/${invite_code}" \
                    ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} 2>/dev/null || echo "")"
                if [ -z "$invite_info" ]; then
                    echo "[claude-talk] ERROR: could not resolve invite code. Check --broker URL." >&2
                    exit 1
                fi

                team_id="$(echo "$invite_info" | python3 -c "import json,sys; print(json.load(sys.stdin)['team_id'])")"
                join_room="$(echo "$invite_info" | python3 -c "import json,sys; print(json.load(sys.stdin)['room'])")"

                # Register membership with the broker
                join_body="$(python3 -c "import json,sys; print(json.dumps({'invite_code':sys.argv[1],'instance_id':sys.argv[2],'name':sys.argv[3]}))" \
                    "$invite_code" "$instance_id" "$member_name")"
                curl -sf -X POST "${tj_broker}/api/teams/${team_id}/join" \
                    -H 'Content-Type: application/json' \
                    ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
                    -d "$join_body" >/dev/null 2>&1 || true

                echo "[claude-talk] joined team (room: $join_room). Connecting to broker..." >&2

                # Save broker URL and token for this session
                mkdir -p "$INBOX_DIR"
                echo "$tj_broker" > "$INBOX_DIR/.broker_url"
                if [ -n "$tj_token" ]; then
                    echo "$tj_token" > "$INBOX_DIR/.mesh_token"
                fi
                printf '{"team_id":"%s","invite_code":"%s","room":"%s"}' \
                    "$team_id" "$invite_code" "$join_room" \
                    > "$INBOX_DIR/.team"

                # Now do a full join to the broker
                exec "$0" join "$tj_broker" "$instance_id" "$member_name" --room "$join_room" \
                    ${tj_token:+--token "$tj_token"}
                ;;

            info)
                # claude-talk team info — show current team + invite command
                team_file="$INBOX_DIR/.team"
                if [ ! -f "$team_file" ]; then
                    echo "[claude-talk] no team configured. Run 'claude-talk team create <name>' or 'claude-talk team join <code>'." >&2
                    exit 1
                fi
                team_id="$(python3 -c "import json,sys; print(json.load(open('$team_file')).get('team_id','?'))")"
                invite_code="$(python3 -c "import json,sys; print(json.load(open('$team_file')).get('invite_code','?'))")"
                room_name="$(python3 -c "import json,sys; print(json.load(open('$team_file')).get('room','?'))")"
                team_name="$(python3 -c "import json,sys; print(json.load(open('$team_file')).get('name','?'))")"

                base="$(_get_base)"
                echo ""
                echo "Current team: $team_name ($team_id)"
                echo "Room:         $room_name"
                echo "Invite code:  $invite_code"
                echo ""
                # Fetch live member list if broker is up
                if curl -sf "${base}/api/health" >/dev/null 2>&1; then
                    echo "Members:"
                    curl -sf "${base}/api/teams/${team_id}" \
                        ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
                    | python3 -c "
import json, sys
data = json.load(sys.stdin)
members = data.get('members', [])
if not members:
    print('  (no members yet)')
else:
    for m in members:
        print(f\"  - {m.get('name', m.get('id','?'))} (id: {m.get('id','?')}, joined: {m.get('joined_at','')})\")
"
                fi
                echo ""
                echo "Join command for others:"
                if [ -n "${MESH_TOKEN:-}" ]; then
                    echo "  MESH_TOKEN=${MESH_TOKEN} BROKER_URL=${base} claude-talk team join ${invite_code} cc2 \"YourName\""
                else
                    echo "  BROKER_URL=${base} claude-talk team join ${invite_code} cc2 \"YourName\""
                fi
                ;;

            *)
                echo "[claude-talk] unknown team subcommand: $subcmd" >&2
                echo "Usage: claude-talk team create|join|info" >&2
                exit 1
                ;;
        esac
        ;;

    stop)
        # claude-talk stop   — unregister this session (keep broker alive)
        me="$(cat "$INBOX_DIR/.me" 2>/dev/null || echo "")"
        if [ -n "$me" ] && [ -f "$INBOX_DIR/${me}.pid" ]; then
            kill "$(cat "$INBOX_DIR/${me}.pid")" 2>/dev/null || true
            rm -f "$INBOX_DIR/${me}.pid"
            echo "[claude-talk] stopped instance $me"
        fi
        rm -f "$INBOX_DIR/.me" "$INBOX_DIR/.room" "$INBOX_DIR/.broker_url"
        ;;

    stop-broker)
        if [ -f "$BROKER_PID_FILE" ]; then
            kill "$(cat "$BROKER_PID_FILE")" 2>/dev/null || true
            rm -f "$BROKER_PID_FILE"
            echo "[claude-talk] broker stopped"
        else
            echo "[claude-talk] no broker pid file"
        fi
        # Also stop any ngrok tunnels
        if [ -f "$HOME/.agent-mesh-ngrok-http.pid" ]; then
            kill "$(cat "$HOME/.agent-mesh-ngrok-http.pid")" 2>/dev/null || true
            rm -f "$HOME/.agent-mesh-ngrok-http.pid"
        fi
        if [ -f "$HOME/.agent-mesh-ngrok-tcp.pid" ]; then
            kill "$(cat "$HOME/.agent-mesh-ngrok-tcp.pid")" 2>/dev/null || true
            rm -f "$HOME/.agent-mesh-ngrok-tcp.pid"
        fi
        ;;

    help|--help|-h|*)
        cat <<EOF
claude-talk — let different Claude Code sessions talk through the local broker.

Usage:
  claude-talk start <id> [name] [--room <name>]
                              register this session as <id> in [room] (auto-starts broker)
  claude-talk send <to> <msg...>  send a message FROM this session TO <to>
  claude-talk inbox [N]           show last N messages addressed to me (default 20)
  claude-talk listen              tail my live message log
  claude-talk who                 show my id + list connected instances (room-scoped)
  claude-talk rooms               list active rooms and their instance counts
  claude-talk room <name>         switch this session's current room (metadata only)
  claude-talk stop                unregister this session
  claude-talk stop-broker         shut down the broker (and ngrok tunnels if running)

Team commands (multi-device, multi-account collaboration):
  claude-talk team create <name> [--room <room>]
                              create a team, save invite code, print join command
  claude-talk team join <invite_code> <instance_id> [name] [--broker <url>] [--token <tok>]
                              join a team from ANY device / Claude account
  claude-talk team info       show current team, members, and ready-to-paste join command

Internet sharing (collaborate with Angus across the internet):
  claude-talk share [--room <name>]
                              start ngrok tunnels and print ONE-liner join command for Angus
  claude-talk share --team    start ngrok, auto-create a team, print the one-liner
  claude-talk join <url> <id> [name] [--room <name>] [--broker <url>] [--token <tok>]
                              connect to a remote broker directly

Typical cross-internet flow (new team system):
  # On Ethan's machine:
  ! claude-talk start cc1 "Ethan" --room sitelab
  ! claude-talk share --team
  # (prints ONE command — paste into Angus's Claude Code with '!' prefix)

  # Angus pastes that one command into his Claude Code session, done.
  # His Claude is in the team, in the same room, receiving messages.

Typical cross-internet flow (manual):
  # On Ethan's machine:
  ! claude-talk start cc1 "Ethan" --room sitelab
  ! claude-talk share --room sitelab
  # (prints a join command — paste it into Angus's terminal)

  # On Angus's machine (paste the printed command):
  ! claude-talk join https://xyz.ngrok.io cc2 "Angus" --room sitelab
  ! claude-talk inbox
  ! claude-talk send cc1 "yo from Angus"

State:
  Broker URL:       $BASE
  Inbox dir:        $INBOX_DIR
  Broker pid file:  $BROKER_PID_FILE
EOF
        ;;
esac

#!/usr/bin/env bash
# claude-talk-bot — poll the mesh inbox and auto-reply via `claude -p`.
#
# Usage:
#   claude-talk-bot <my-id> [--persona "..."] [--max-turns N] [--budget-usd X]
#
# What it does:
#   1. Polls /api/status every ~2s for messages addressed to <my-id>
#   2. For each NEW message (tracked by id in a seen-set file), pipes the
#      text into `claude -p` with an optional persona system prompt
#   3. Sends the reply back to the original sender via claude-talk send
#   4. Stops after --max-turns replies (default 8) so it can't run away
#
# Cost: capped via --max-budget-usd (default $0.50). Uses --allowedTools none
# so the bot doesn't accidentally start running shell commands or editing files.

set -euo pipefail

MY_ID="${1:?usage: claude-talk-bot <my-id> [--persona '...'] [--max-turns N] [--budget-usd X]}"
shift

PERSONA=""
DISPLAY_NAME=""
MAX_TURNS=8
BUDGET="0.50"
REPLY_TO_HUMAN=0
REPLY_TO_AGENTS=0   # default OFF — prevents bot-to-bot loops
BOT_CHAIN_LIMIT=4   # stop if last N msgs in thread are all bots (no human)
HISTORY_LIMIT=5     # past msgs in context window — smaller = less cross-test contamination

# Named persona shortcuts. "alpha" / "bravo" become a full team prompt with
# the bot's identity, its partner, and explicit instructions to use the
# conversation history rather than reasoning in isolation.
_persona_template() {
    local name="$1" partner="$2"
    cat <<EOF
You are $name, one of two AI agents ($name and $partner) collaborating in a
shared channel. $partner is your partner. You will be shown the recent
conversation history in this channel before each turn — read it carefully and
respond AWARE of what $partner and the user have said.

Rules:
- Keep replies short (1-2 sentences) unless a long answer is clearly needed.
- Stay in character as $name. Do not narrate that you are an AI.
- If the user asks you and $partner to do something together (finish a
  sentence, take turns, divide work), use the history to coordinate.
- If the last message is from $partner, build on it rather than ignoring it.
- Don't narrate your own name unnecessarily ("I am $name..."). But DO follow
  explicit instructions to say a specific word — even if that word also
  appears in the prompt asking you to say it.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --persona)         PERSONA="$2"; shift 2 ;;
        --name)            DISPLAY_NAME="$2"; shift 2 ;;
        --max-turns)       MAX_TURNS="$2"; shift 2 ;;
        --budget-usd)      BUDGET="$2"; shift 2 ;;
        --reply-to-human)  REPLY_TO_HUMAN=1; shift ;;
        --reply-to-agents) REPLY_TO_AGENTS=1; shift ;;
        --bot-chain-limit) BOT_CHAIN_LIMIT="$2"; shift 2 ;;
        --history-limit)   HISTORY_LIMIT="$2"; shift 2 ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
done

# Resolve named persona shortcuts.
case "$PERSONA" in
    alpha) DISPLAY_NAME="${DISPLAY_NAME:-Alpha}"; PERSONA="$(_persona_template Alpha Bravo)" ;;
    bravo) DISPLAY_NAME="${DISPLAY_NAME:-Bravo}"; PERSONA="$(_persona_template Bravo Alpha)" ;;
    "")    PERSONA="You are an agent on the Agent Mesh. Keep replies short (1-2 sentences)." ;;
esac
DISPLAY_NAME="${DISPLAY_NAME:-$MY_ID}"

BASE="http://${MESH_HOST:-localhost}:${MESH_UI_PORT:-8765}"
SEEN_FILE="$HOME/.agent-mesh-inbox/${MY_ID}.seen"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Source MESH_TOKEN if unset: live session env first, then the inbox token file.
if [ -z "${MESH_TOKEN:-}" ]; then
    MESH_TOKEN="$(grep '^MESH_TOKEN=' "$HOME/.agent-mesh/session.env" 2>/dev/null | head -1 | cut -d= -f2 || true)"
fi
if [ -z "${MESH_TOKEN:-}" ]; then
    MESH_TOKEN="$(cat "$HOME/.agent-mesh-inbox/.mesh_token" 2>/dev/null || true)"
fi

# Precheck: fail with a clear message if the broker rejects our token, instead
# of dying with a python traceback under set -euo pipefail.
auth_check="$(curl -s -o /dev/null -w '%{http_code}' \
    ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
    "${BASE}/api/status" || true)"
if [ "$auth_check" = "401" ]; then
    echo "[bot:${MY_ID}] ERROR: MESH_TOKEN missing/invalid — broker returned 401 for ${BASE}/api/status" >&2
    echo "  Set MESH_TOKEN, or check ~/.agent-mesh/session.env / ~/.agent-mesh-inbox/.mesh_token" >&2
    exit 1
fi

mkdir -p "$(dirname "$SEEN_FILE")"
touch "$SEEN_FILE"

# Mark every message currently in state as seen, so the bot only replies to NEW
# messages that arrive after it starts. (Otherwise it'd respond to every
# historical message on first poll.)
curl -sf "${BASE}/api/status" \
    ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
| python3 -c "
import json, sys, pathlib
data = json.load(sys.stdin)
seen = pathlib.Path('$SEEN_FILE')
ids = set(seen.read_text().splitlines()) if seen.exists() else set()
for m in data.get('messages', []):
    ids.add(m.get('id', ''))
seen.write_text('\n'.join(sorted(i for i in ids if i)) + '\n')
"

echo "[bot:${MY_ID}] watching inbox (persona: ${PERSONA:0:60}...; max-turns=$MAX_TURNS; budget=\$$BUDGET)"

turns_taken=0
while [ "$turns_taken" -lt "$MAX_TURNS" ]; do
    sleep 2

    # Pull current state, find unseen messages addressed to me.
    new_messages_json=$(
        curl -sf "${BASE}/api/status" \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
        | python3 -c "
import json, sys, pathlib, datetime
me = '$MY_ID'
# Skip msgs older than this when we first see them — prevents the bot from
# replying to stale backlog if it ever lags behind (the symptom hypothesised
# for C2: stale trigger picked up while a newer prompt sits in context).
STALE_SECONDS = 120
seen = set(pathlib.Path('$SEEN_FILE').read_text().splitlines())
data = json.load(sys.stdin)
now = datetime.datetime.now(datetime.timezone.utc)
new, stale_seen = [], []
for m in data.get('messages', []):
    mid = m.get('id', '')
    if not mid or mid in seen:
        continue
    if m.get('from') == me:
        continue  # ignore my own messages
    to = m.get('to')
    sender = m.get('from')
    # Broadcasts: only reply when the human sent them. Bot-to-bot broadcasts
    # create infinite reply loops (A broadcasts -> B replies to=all -> A sees
    # B's broadcast and replies -> ...), so we suppress them here.
    if to == 'all' and sender != 'you':
        continue
    if to not in (me, 'all'):
        continue
    ts = m.get('ts', '')
    try:
        age = (now - datetime.datetime.fromisoformat(
            ts.replace('Z','+00:00'))).total_seconds()
    except Exception:
        age = 0
    if age > STALE_SECONDS:
        stale_seen.append(mid)
        continue
    new.append(m)
# Mark stale msgs as seen so we don't re-evaluate them every poll.
if stale_seen:
    seen.update(stale_seen)
    pathlib.Path('$SEEN_FILE').write_text(
        '\n'.join(sorted(i for i in seen if i)) + '\n')
print(json.dumps(new))
"
    ) || continue

    [ "$new_messages_json" = "[]" ] && continue

    # Iterate over new messages.
    echo "$new_messages_json" | python3 -c "
import json, sys
for m in json.loads(sys.stdin.read()):
    print(json.dumps(m))
" | while read -r msg_json; do
        sender=$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('from',''))")
        text=$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('text',''))")
        mid=$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('id',''))")
        orig_to=$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('to',''))")
        orig_channel=$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('channel',''))")

        # E2E test harness inserts [RESET] markers between tests to clear the
        # bot's context window. Mark seen and skip (no reply, no cost).
        if [[ "$text" == \[RESET\]* ]]; then
            echo "[bot:${MY_ID}] skipping RESET marker $mid"
            echo "$mid" >> "$SEEN_FILE"
            continue
        fi

        # Reply policy:
        #   sender == 'you'  (human via dashboard) -> requires --reply-to-human
        #   sender == another agent (cc-*)         -> requires --reply-to-agents
        #                                            AND msg must carry a channel
        # Both off by default to prevent loops and accidental cost.
        if [ "$sender" = "you" ] && [ "$REPLY_TO_HUMAN" -ne 1 ]; then
            echo "[bot:${MY_ID}] skipping human message $mid (use --reply-to-human)"
            echo "$mid" >> "$SEEN_FILE"
            continue
        fi
        if [ "$sender" != "you" ]; then
            if [ "$REPLY_TO_AGENTS" -ne 1 ]; then
                echo "[bot:${MY_ID}] skipping agent message $mid from $sender (use --reply-to-agents)"
                echo "$mid" >> "$SEEN_FILE"
                continue
            fi
            # Direct cc->cc (no channel) is intentionally muted to prevent
            # accidental loops. Agent-to-agent coordination goes through
            # channels — see /api/channels.
            if [ -z "$orig_channel" ]; then
                echo "[bot:${MY_ID}] skipping direct agent message $mid from $sender (channel-only)"
                echo "$mid" >> "$SEEN_FILE"
                continue
            fi
        fi

        echo "[bot:${MY_ID}] new message from $sender: ${text:0:80}"

        # Mark seen FIRST so a crashing claude call doesn't re-process forever.
        echo "$mid" >> "$SEEN_FILE"

        # ----- Build conversation context + loop-guard counts -----
        # Pull the relevant slice of history (same channel, or 1-on-1, or
        # broadcast) and format as `[HH:MM] sender: text` lines. Also count
        # how many of the most recent messages were bot-generated so we can
        # abort if the conversation has degenerated into bot-only echoes.
        context_and_guard=$(curl -sf "${BASE}/api/state" \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
        | MY_ID="$MY_ID" ORIG_CHAN="$orig_channel" ORIG_TO="$orig_to" \
          ORIG_FROM="$sender" \
          TRIGGER_ID="$mid" HISTORY_LIMIT="$HISTORY_LIMIT" \
          BOT_CHAIN_LIMIT="$BOT_CHAIN_LIMIT" \
          python3 -c '
import json, os, sys, datetime
me = os.environ["MY_ID"]
ch = os.environ.get("ORIG_CHAN","")
to = os.environ.get("ORIG_TO","")
frm = os.environ.get("ORIG_FROM","")
trig = os.environ.get("TRIGGER_ID","")
limit = int(os.environ.get("HISTORY_LIMIT","10"))
guard = int(os.environ.get("BOT_CHAIN_LIMIT","4"))

d = json.load(sys.stdin)
msgs = d.get("messages", [])
meta = d.get("instances_meta", {})

def display(iid):
    if iid == "you": return "user"
    if iid == me:    return meta.get(me, {}).get("name", me)
    return meta.get(iid, {}).get("name", iid)

# Filter to the thread that contains the trigger.
# Partner = whoever sent the trigger ("you" for human, or another cc-*).
# Including agent-to-agent threads here is what unblocks T06.
if ch:
    rel = [m for m in msgs if m.get("channel") == ch]
elif to == "all":
    rel = [m for m in msgs if m.get("to") == "all" or
           (m.get("from") == "you" and m.get("to") == me)]
else:
    partner = frm or "you"
    rel = [m for m in msgs
           if not m.get("channel")
           and ((m.get("from") == partner and m.get("to") == me)
                or (m.get("from") == me and m.get("to") == partner))]

# Trim to a window ending at the trigger (inclusive).
trig_idx = next((i for i, m in enumerate(rel) if m.get("id") == trig),
                len(rel) - 1)
start = max(0, trig_idx + 1 - limit)
window = rel[start:trig_idx + 1]

# Loop-guard: in the last `guard` messages (excluding the trigger), if there
# are NO human messages and the bot has already participated, stop. The
# trigger itself is allowed to be a bot (--reply-to-agents mode).
tail = rel[max(0, trig_idx - guard):trig_idx]
human_recent = any(m.get("from") == "you" for m in tail)
me_in_tail = any(m.get("from") == me for m in tail)
should_stop = (not human_recent) and me_in_tail and len(tail) >= guard

lines = []
for m in window:
    ts = m.get("ts", "")
    try:
        t = datetime.datetime.fromisoformat(ts.replace("Z","+00:00")).strftime("%H:%M")
    except Exception:
        t = "??:??"
    who = display(m.get("from", ""))
    txt = m.get("text", "")
    lines.append("[" + t + "] " + who + ": " + txt)

print("STOP" if should_stop else "GO")
print("\n".join(lines))
')
        guard_verdict=$(printf '%s' "$context_and_guard" | head -n1)
        context=$(printf '%s' "$context_and_guard" | tail -n +2)

        if [ "$guard_verdict" = "STOP" ]; then
            echo "[bot:${MY_ID}] loop guard tripped — last $BOT_CHAIN_LIMIT msgs in thread are bots without a human; not replying"
            continue
        fi

        # Compose the user prompt: history + an explicit "now reply as ME" line.
        # The system prompt (persona) holds the identity rules.
        full_prompt=$(printf '%s\n\nReply as %s. Use the history above for context. Do not narrate.' \
            "$context" "$DISPLAY_NAME")

        # Invoke claude. --allowedTools none keeps it text-only (no shell/edit
        # access from the bot). We deliberately do NOT pass --bare because it
        # disables OAuth/keychain auth and only reads ANTHROPIC_API_KEY.
        reply=$(claude -p "$full_prompt" \
            --model "${BOT_MODEL:-haiku}" \
            --append-system-prompt "$PERSONA" \
            --allowedTools "none" \
            --max-budget-usd "$BUDGET" \
            --effort low \
            2>>"$HOME/.agent-mesh-inbox/${MY_ID}.claude.err") || reply=""

        if [ -z "$reply" ]; then
            echo "[bot:${MY_ID}] claude returned empty; not replying"
            continue
        fi

        # Reply to the same audience as the original. If user broadcast to=all,
        # the reply also goes to=all so it shows in the BROADCAST thread instead
        # of disappearing into a 1-on-1 view.
        reply_to="$sender"
        if [ "$orig_to" = "all" ]; then
            reply_to="all"
        fi

        echo "[bot:${MY_ID}] → $reply_to${orig_channel:+ (channel=$orig_channel)}: ${reply:0:80}"
        body="$(python3 -c "
import json, sys
out = {'to': sys.argv[1], 'text': sys.argv[2], 'from': sys.argv[3]}
ch = sys.argv[4] if len(sys.argv) > 4 else ''
if ch:
    out['channel'] = ch
print(json.dumps(out))
" "$reply_to" "$reply" "$MY_ID" "$orig_channel")"
        curl -sf -X POST "${BASE}/api/send" \
            -H 'Content-Type: application/json' \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
            -d "$body" >/dev/null || true

        # Also mark the reply we just sent so we don't re-process it on next poll.
        sleep 0.5
        curl -sf "${BASE}/api/status" \
            ${MESH_TOKEN:+-H "X-Mesh-Token: $MESH_TOKEN"} \
        | python3 -c "
import json, sys, pathlib
me = '$MY_ID'
seen = pathlib.Path('$SEEN_FILE')
ids = set(seen.read_text().splitlines())
data = json.load(sys.stdin)
for m in data.get('messages', []):
    if m.get('from') == me:
        ids.add(m.get('id', ''))
seen.write_text('\n'.join(sorted(i for i in ids if i)) + '\n')
"
    done

    # Re-count turns by counting non-empty lines in seen-file minus initial state
    # (simple approximation — could be more precise)
    turns_taken=$((turns_taken + 1))
done

echo "[bot:${MY_ID}] reached max-turns=$MAX_TURNS, exiting"
